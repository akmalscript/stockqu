# StockQu - template environment. Copy ke .env lalu isi nilai aslinya. JANGAN commit .env.

# development untuk localhost. Pada deployment gunakan production; mode production
# menolak localhost, HTTP, dan URL placeholder agar webhook tidak salah arah.
STOCKQU_ENV=development
STOCKQU_ALLOW_HTTP_N8N=0

# Supabase (P0)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side saja (Agent Service / CLI): dipakai untuk read cron/CLI dan menulis
# analyst_forecasts, agent_logs, sync_logs, inventory, serta procurement plan.
# Jangan pernah ditaruh di kode atau ditampilkan di UI.
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets (P1) - sumber stok real-time, sinkron dua arah
# ID atau URL spreadsheet. Share spreadsheet ke email service account sebagai Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_STOCK_TAB=Stok
# Pilih salah satu: path file JSON service account, ATAU isi JSON-nya (untuk Streamlit Cloud secrets)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# P4 - Orkestrasi & Approval (Agent Service + n8n)
# Postgres connection string untuk checkpoint LangGraph (Supabase -> Connect -> Session pooler).
SUPABASE_DB_URL=
# Token n8n -> Agent Service (header Authorization: Bearer ...) dan Agent Service -> n8n.
N8N_TO_SERVICE_TOKEN=
SERVICE_TO_N8N_TOKEN=
# URL publik HTTPS Agent Service (dipakai Streamlit + callback W5) dan webhook n8n W2/W4.
STOCKQU_AGENT_SERVICE_URL=
AGENT_SERVICE_PUBLIC_URL=
N8N_WA_NOTIFY_WEBHOOK_URL=
N8N_PO_EMAIL_WEBHOOK_URL=
# WhatsApp approval: nomor manager (E.164, pisah koma) + auth token Twilio untuk cek signature.
APPROVER_WHATSAPP_NUMBERS=
TWILIO_AUTH_TOKEN=
# Opsional demo: semua email PO dikirim ke inbox uji ini, bukan ke supplier.
PO_EMAIL_TEST_RECIPIENT=
GOOGLE_SHEETS_INCOMING_TAB=Incoming
