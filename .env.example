# StockQu - template environment. Copy ke .env lalu isi nilai aslinya. JANGAN commit .env.

# Supabase (P0)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side saja (Agent Service / CLI): dipakai untuk menulis analyst_forecasts, agent_logs,
# sync_logs, dan inventory. Jangan pernah ditaruh di kode atau ditampilkan di UI.
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets (P1) - sumber stok real-time, sinkron dua arah
# ID atau URL spreadsheet. Share spreadsheet ke email service account sebagai Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_STOCK_TAB=Stok
# Pilih salah satu: path file JSON service account, ATAU isi JSON-nya (untuk Streamlit Cloud secrets)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
