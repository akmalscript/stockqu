{
  "name": "StockQu W2 - Kirim WA approval",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "stockqu-wa-notify",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "f4da6dc0-94b5-5f3b-978d-7d9e2b960b31",
      "name": "Approval request (dari Agent Service)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "StockQu inbound (Bearer SERVICE_TO_N8N_TOKEN)"
        }
      },
      "webhookId": "stockqu-wa-notify"
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nreturn (b.to || []).map(to => ({ json: { to, message: b.message, approval_code: b.approval_code } }));"
      },
      "id": "92613985-367f-528b-aa61-edea7ba018b8",
      "name": "Satu item per approver",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "from": "={{ $env.TWILIO_WHATSAPP_FROM }}",
        "to": "={{ $json.to }}",
        "toWhatsapp": true,
        "message": "={{ $json.message }}"
      },
      "id": "cbfba003-0dd2-5b00-8143-a8bfa11d2465",
      "name": "Twilio WhatsApp",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [
        520,
        0
      ],
      "credentials": {
        "twilioApi": {
          "id": "REPLACE_ME",
          "name": "Twilio WhatsApp Sandbox"
        }
      }
    }
  ],
  "connections": {
    "Approval request (dari Agent Service)": {
      "main": [
        [
          {
            "node": "Satu item per approver",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Satu item per approver": {
      "main": [
        [
          {
            "node": "Twilio WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jakarta",
    "saveDataErrorExecution": "all"
  },
  "meta": {
    "stockqu": "Isi pesan & nomor approver dibuat Agent Service. Ganti node Twilio untuk sender produksi (NF-21)."
  },
