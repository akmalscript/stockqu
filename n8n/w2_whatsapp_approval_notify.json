{
  "name": "StockQu W2 - Kirim WA approval via Fonnte",
  "nodes": [
    {
      "parameters": {"httpMethod": "POST", "path": "stockqu-wa-notify", "authentication": "headerAuth", "responseMode": "onReceived", "options": {}},
      "id": "f4da6dc0-94b5-5f3b-978d-7d9e2b960b31",
      "name": "Approval request dari Agent Service",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "credentials": {"httpHeaderAuth": {"id": "REPLACE_ME", "name": "StockQu inbound"}},
      "webhookId": "stockqu-wa-notify"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? {};\nconst recipients = Array.isArray(body.to) ? body.to : [];\nconst message = String(body.message ?? '').trim();\nconst approvalCode = String(body.approval_code ?? '').trim();\nif (!recipients.length) throw new Error('APPROVER_MISSING');\nif (!message || !/^APR-\\d{8}-\\d{2,}$/.test(approvalCode)) throw new Error('APPROVAL_PAYLOAD_INVALID');\nreturn recipients.map((recipient) => {\n  const target = String(recipient).replace(/[^0-9]/g, '');\n  if (!target) throw new Error('APPROVER_NUMBER_INVALID');\n  return { json: { target, message, approval_code: approvalCode } };\n});"
      },
      "id": "92613985-367f-528b-aa61-edea7ba018b8",
      "name": "Validasi dan pisahkan approver",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fonnte.com/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {"parameters": [
          {"name": "target", "value": "={{ $json.target }}"},
          {"name": "message", "value": "={{ $json.message }}"},
          {"name": "countryCode", "value": "0"},
          {"name": "connectOnly", "value": "true"}
        ]},
        "options": {"timeout": 20000}
      },
      "id": "8d210b9e-530a-49dc-8721-d1a6bfb96a74",
      "name": "Fonnte kirim approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 0],
      "credentials": {"httpHeaderAuth": {"id": "REPLACE_ME", "name": "StockQu Fonnte API Token"}},
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3},
          "conditions": [{
            "id": "76a3bf41-44e1-47ca-bc9a-a7af86d6cc37",
