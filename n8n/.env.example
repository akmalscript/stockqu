# Konfigurasi non-secret yang diteruskan ke expression workflow n8n.
# Copy ke n8n/.env. File n8n/.env diabaikan Git.

N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678
N8N_PROXY_HOPS=0
SUPABASE_URL=

# Dari dalam Docker Desktop, service lokal host biasanya memakai host.docker.internal.
STOCKQU_AGENT_SERVICE_URL=http://host.docker.internal:8000

# Secret acak minimal 32 karakter untuk URL webhook Fonnte W3.
# Set URL device Fonnte ke: <WEBHOOK_URL>/webhook/stockqu-wa-inbound?secret=<nilai ini>
FONNTE_WEBHOOK_SECRET=

# Token Fonnte, OAuth Gmail, service-role Supabase, dan bearer token TIDAK
# ditaruh di file ini. Simpan semuanya sebagai Credentials di UI n8n.
