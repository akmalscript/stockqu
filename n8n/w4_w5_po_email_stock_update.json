    {
      "parameters": {
        "jsCode": "const claim = $input.first().json;\nconst payload = $('PO approved (dari Agent Service)').first().json.body ?? {};\nif (String(payload.po_id ?? '') !== String(claim.po_id ?? '')) throw new Error('PO_ID_MISMATCH');\nif (String(payload.po_number ?? '') !== String(claim.po_number ?? '')) throw new Error('PO_NUMBER_MISMATCH');\nconst pdf = String(payload.pdf_base64 ?? '').trim();\nif (!pdf || pdf.length > 20000000 || !/^[A-Za-z0-9+/\\r\\n]+={0,2}$/.test(pdf)) throw new Error('PO_PDF_INVALID');\nconst rupiah = (value) => `Rp ${new Intl.NumberFormat('id-ID', { maximumFractionDigits: 0 }).format(Number(value ?? 0))}`;\nconst items = Array.isArray(claim.items) ? claim.items : [];\nconst itemLines = items.map((item) => `- ${item.sku} — ${item.name}: ${item.qty} x ${rupiah(item.unit_price)} = ${rupiah(item.line_total)}`);\nconst subject = `Purchase Order ${claim.po_number} - StockQu`;\nconst emailBody = [\n  `Yth. ${claim.supplier_name},`,\n  '',\n  `Terlampir Purchase Order ${claim.po_number} dari StockQu.`,\n  `Total: ${rupiah(claim.total_amount)}`,\n  `Tanggal pengiriman diminta: ${claim.requested_delivery_date}`,\n  '',\n  'Rincian pesanan:',\n  ...itemLines,\n  '',\n  'Mohon konfirmasi penerimaan dan jadwal pengiriman.',\n  '',\n  'Salam,',\n  'Tim Procurement StockQu',\n].join('\\n');\nreturn [{ json: { ...claim, subject, email_body: emailBody, pdf_base64: pdf, pdf_filename: `${claim.po_number}.pdf` } }];"
      },
