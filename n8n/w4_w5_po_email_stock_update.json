{
  "name": "StockQu W4/W5 - Email PO + update stok",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "stockqu-po-email",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a91e9f6f-5762-5de8-90ce-6750a557cdbe",
      "name": "PO approved (dari Agent Service)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "StockQu inbound (Bearer SERVICE_TO_N8N_TOKEN)"
        }
      },
      "webhookId": "stockqu-po-email"
    },
    {
      "parameters": {
        "operation": "toBinary",
        "sourceProperty": "body.pdf_base64",
        "binaryPropertyName": "po_pdf",
        "options": {
          "fileName": "={{ $json.body.pdf_filename }}",
          "mimeType": "application/pdf"
        }
      },
      "id": "a93ac4d8-bf8f-510c-835f-6e47eb27c183",
      "name": "PDF PO",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $('PO approved (dari Agent Service)').item.json.body.to }}",
        "subject": "={{ $('PO approved (dari Agent Service)').item.json.body.subject }}",
        "emailType": "text",
        "message": "={{ $('PO approved (dari Agent Service)').item.json.body.body }}",
        "options": {
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "po_pdf"
              }
            ]
          },
          "appendAttribution": false
        }
      },
      "id": "3aef403b-ef12-5506-a376-76f196731e2a",
      "name": "W4 - Gmail kirim PO",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        480,
        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_ME",
          "name": "Gmail StockQu"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('PO approved (dari Agent Service)').item.json.body.callback_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email_message_id: $json.id }) }}",
        "options": {
          "timeout": 30000,
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 2000
          }
        }
      },
      "id": "bf91db2b-8f89-566a-bd04-a92d061aff68",
      "name": "W5 - Tandai sent + stok in-transit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "StockQu Agent Service (Bearer N8N_TO_SERVICE_TOKEN)"
        }
      }
    }
  ],
  "connections": {
    "PO approved (dari Agent Service)": {
      "main": [
        [
          {
            "node": "PDF PO",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "PDF PO": {
      "main": [
        [
          {
            "node": "W4 - Gmail kirim PO",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "W4 - Gmail kirim PO": {
      "main": [
        [
          {
            "node": "W5 - Tandai sent + stok in-transit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jakarta",
    "saveDataErrorExecution": "all"
  },
  "meta": {
    "stockqu": "Webhook ini hanya dipanggil untuk PO berstatus approved. W5 ditolak database bila PO belum approved."
  },
  "pinData": {}
}
