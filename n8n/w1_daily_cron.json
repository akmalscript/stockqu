{
  "name": "StockQu W1 - Cron 07:00 WIB",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "157cdf39-821e-5075-9c5c-5033db20597c",
      "name": "Setiap hari 07:00 WIB",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.STOCKQU_AGENT_SERVICE_URL }}/workflows/daily-run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ trigger: \"cron\", requested_by: \"n8n:w1-cron\" }) }}",
        "options": {
          "timeout": 30000,
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 2000
          }
        }
      },
      "id": "eaffda45-8036-5de9-93bd-80a9e68f92a5",
      "name": "Jalankan workflow harian",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "StockQu Agent Service (Bearer N8N_TO_SERVICE_TOKEN)"
        }
      }
    }
  ],
  "connections": {
    "Setiap hari 07:00 WIB": {
      "main": [
        [
          {
            "node": "Jalankan workflow harian",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jakarta",
    "saveDataErrorExecution": "all"
  },
  "meta": {
    "stockqu": "Agent Service menolak duplikat per hari (job_key daily:YYYY-MM-DD) dan berjalan async."
  },
  "pinData": {}
}
