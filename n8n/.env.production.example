# n8n production template. Simpan nilai asli di secret manager/host, jangan commit .env.
# Ganti domain *.invalid sebelum menjalankan compose production.

N8N_PORT=5678
N8N_HOST=n8n.stockqu.invalid
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://n8n.stockqu.invalid
WEBHOOK_URL=https://n8n.stockqu.invalid
N8N_PROXY_HOPS=1
N8N_ENCRYPTION_KEY=

SUPABASE_URL=https://project.stockqu.invalid
STOCKQU_AGENT_SERVICE_URL=https://agent.stockqu.invalid
FONNTE_WEBHOOK_SECRET=

# OAuth Gmail, Supabase service-role, token Fonnte, dan bearer token tetap dibuat
# sebagai Credentials terenkripsi di UI n8n; jangan taruh nilainya di file ini.
