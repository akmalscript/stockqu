{
  "name": "StockQu W3 - Terima balasan WA",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "stockqu-wa-inbound",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "891e701d-4bca-5764-b9eb-fd53c490cc33",
      "name": "Twilio inbound",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "stockqu-wa-inbound"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.STOCKQU_AGENT_SERVICE_URL }}/webhooks/whatsapp-reply",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ webhook_url: $env.STOCKQU_WA_INBOUND_URL, twilio_signature: $('Twilio inbound').item.json.headers['x-twilio-signature'] || '', params: $('Twilio inbound').item.json.body }) }}",
        "options": {
          "timeout": 30000,
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 2000
          }
        }
      },
      "id": "9770807c-67a0-596a-ba4b-ba9f8e330119",
      "name": "Validasi & putuskan (Agent Service)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "StockQu Agent Service (Bearer N8N_TO_SERVICE_TOKEN)"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<Response><Message>{{ $json.reply_text }}</Message></Response>",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/xml"
              }
            ]
          }
        }
      },
      "id": "c7121e8a-5f1d-5b23-a7df-f1da6283b7dd",
      "name": "Balas TwiML ke Twilio",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        520,
        0
      ]
    }
  ],
  "connections": {
