# StockQu Agent Service - production template.
# Salin ke secret manager platform Agent Service, BUKAN ke repository.
# Domain *.invalid sengaja ditolak validator; ganti dengan domain HTTPS publik Anda.

STOCKQU_ENV=production
STOCKQU_ALLOW_HTTP_N8N=0

SUPABASE_URL=https://project.stockqu.invalid
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres.your-project:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_STOCK_TAB=Stok
GOOGLE_SHEETS_INCOMING_TAB=Incoming
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Kedua URL ini harus menunjuk Agent Service yang sama.
STOCKQU_AGENT_SERVICE_URL=https://agent.stockqu.invalid
AGENT_SERVICE_PUBLIC_URL=https://agent.stockqu.invalid

# Generate dua token acak berbeda, minimal 32 karakter.
N8N_TO_SERVICE_TOKEN=
SERVICE_TO_N8N_TOKEN=

N8N_WA_NOTIFY_WEBHOOK_URL=https://n8n.stockqu.invalid/webhook/stockqu-wa-notify
N8N_PO_EMAIL_WEBHOOK_URL=https://n8n.stockqu.invalid/webhook/stockqu-po-email

WHATSAPP_PROVIDER=fonnte
APPROVER_WHATSAPP_NUMBERS=
TWILIO_AUTH_TOKEN=
